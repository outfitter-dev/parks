{
  "name": "@outfitter/parks-showcase",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./lib/*.ts",
    "#demos/*": "./demos/*.tsx",
    "#app/*": "./app/*.tsx"
  },
  "scripts": {
    "dev": "bun run --cwd ../../packages/parks build && bun run dev:app",
    "build": "bun run --cwd ../../packages/parks build && next build",
    "start": "next start --port 3100",
    "typecheck": "bun run --cwd ../../packages/parks build && next typegen && tsc --noEmit",
    "dev:app": "next dev --port 3100"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@outfitter/parks": "workspace:*",
    "@pierre/diffs": "1.7.1",
    "@pierre/trees": "1.0.0",
    "@solar-icons/react": "2.7.0",
    "allo-font": "1.0.3",
    "class-variance-authority": "0.7.1",
    "dialkit": "2.2.1",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "agentation": "3.1.2",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}

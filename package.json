{
  "name": "parks-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for @outfitter/parks, Outfitter's design system, and its showcase.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outfitter-dev/parks.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p . && bun run --cwd apps/showcase typecheck",
    "test": "vitest run",
    "dev": "bun scripts/dev.ts",
    "build": "bun run --cwd apps/showcase build",
    "changeset": "changeset",
    "ui:add": "bun scripts/ui-add.ts",
    "ui:palette": "bun scripts/ui-palette.ts",
    "check:consumer": "bun scripts/check-consumer.ts",
    "ui:theme": "bun scripts/ui-theme.ts",
    "check:contrast": "bun scripts/check-contrast.ts",
    "registry:build": "shadcn build registry.json -o apps/showcase/public/r"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "ultracite": "8.3.1",
    "vitest": "5.1.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}

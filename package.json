{
  "name": "parks-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for @outfitter/parks, Outfitter's design system, and its showcase.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outfitter-dev/parks.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p . && bun run --cwd apps/showcase typecheck",
    "test": "vitest run",
    "dev": "bun run --cwd apps/showcase dev",
    "build": "bun run --cwd apps/showcase build",
    "changeset": "changeset",
    "ui:add": "bun scripts/ui-add.ts",
    "ui:palette": "bun scripts/ui-palette.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "ultracite": "8.1.1",
    "vitest": "5.1.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}

{
  "name": "@outfitter/parks",
  "version": "0.1.0",
  "description": "Outfitter's design system: tokens, theme CSS, components and UI rules for React and Tailwind CSS v4.",
  "homepage": "https://parks.outfitter.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outfitter-dev/parks.git",
    "directory": "packages/parks"
  },
  "bin": {
    "parks": "dist/rules/cli.js"
  },
  "files": [
    "dist",
    "src",
    "icons.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": {
      "types": "./src/components/*.tsx",
      "bun": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "#lib/*": {
      "types": "./src/lib/*.ts",
      "bun": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "#hooks/*": {
      "types": "./src/hooks/*.ts",
      "bun": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "#rules/*": {
      "types": "./src/rules/*.ts",
      "bun": "./src/rules/*.ts",
      "default": "./dist/rules/*.js"
    }
  },
  "exports": {
    "./styles.css": "./src/styles/styles.css",
    "./globals.css": "./src/styles/globals.css",
    "./themes/*.css": "./src/themes/*.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./package.json": "./package.json",
    "./rules/*": {
      "types": "./dist/rules/*.d.ts",
      "default": "./dist/rules/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "cp ../../THIRD_PARTY_NOTICES.md . && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@shadcn/react": "0.3.1",
    "@solar-icons/react": "2.7.0",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "input-otp": "1.5.0",
    "react-resizable-panels": "4.24.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "playwright-core": "^1.50.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  }
}
